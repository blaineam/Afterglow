    "Your last WebXR session ran at {fps} frames a second. Pages with heavy scenes run slower, and a hot phone slower still.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte WebXR-Sitzung lief mit {fps} Bildern pro Sekunde. Seiten mit aufwendigen Szenen laufen langsamer, auf einem heißen Handy noch langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu última sesión de WebXR fue a {fps} fotogramas por segundo. Las páginas con escenas pesadas van más lentas, y más aún si el teléfono está caliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernière session WebXR tournait à {fps} images par seconde. Les pages aux scènes lourdes sont plus lentes, et plus encore si le téléphone chauffe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima sessione WebXR andava a {fps} fotogrammi al secondo. Le pagine con scene pesanti sono più lente, e con un telefono caldo ancora di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のWebXRセッションは毎秒{fps}フレームで動作しました。負荷の高いシーンを含むページでは速度が落ち、iPhoneが熱くなるとさらに遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 WebXR 세션은 초당 {fps}프레임으로 실행되었습니다. 장면이 무거운 페이지는 더 느려지고, 휴대폰이 뜨거우면 더욱 느려집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua última sessão WebXR rodou a {fps} quadros por segundo. Páginas com cenas pesadas ficam mais lentas, e um celular quente, mais ainda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你上次的 WebXR 会话以每秒 {fps} 帧运行。场景复杂的页面运行更慢,手机发热时还会更慢。"
          }
        }
      }
    },
